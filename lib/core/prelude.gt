// Prelude của `gritc` (giả lập `lib/core`; M12 thay bằng thư viện lõi thật). Thân hàm của prelude KHÔNG được kiểm
// (intrinsic trusted, D22); chỉ chữ ký và hợp đồng có nghĩa. Nguồn cho gritc; test của gt-types dùng bản trùng
// (gt-driver có test khoá hai bản bằng nhau).
#lang(option)
⊔ Option<T> { None, Some(T) }
⊔ Result<T, E> { Ok(T), Err(E) }
#lang(range)
▢ Range<T> { start: T, end: T }
#lang(range_inclusive)
▢ RangeInclusive<T> { start: T, end: T }
#lang(copy)
⊏ Copy { }
#lang(send)
⊏ Send { }
ƒ spawn<A: Send>(f: ƒ(A) ! {detach}, a: A) ! {detach} { }
#lang(sync)
⊏ Sync { }
#lang(atomic_ordering)
⊔ AtomicOrdering { Relaxed, Acquire, Release, AcqRel, SeqCst }
// Kết quả so sánh ba chiều (ADR-032, Q71): enum thay cho số để không có giá trị không hợp lệ. Enum nguyên tử là `AtomicOrdering`.
⊔ Ordering { Less, Equal, Greater }
// Thứ tự toàn phần do NGƯỜI DÙNG cài (`⊐ Ord for X`); lib/core không cài sẵn cho kiểu nào (thân prelude không có MIR).
⊏ Ord { ƒ cmp(&self, o: &Self) → Ordering ! ∅; }
#lang(atomic_int)
⊏ AtomicInt { }
⊐ AtomicInt for bool { }
⊐ AtomicInt for i32 { }
⊐ AtomicInt for u32 { }
⊐ AtomicInt for i64 { }
⊐ AtomicInt for u64 { }
⊐ AtomicInt for usize { }
#lang(atomic)
▢ Atomic<T: AtomicInt> { v: T }
⊐ <T: AtomicInt> Atomic<T> {
  ƒ new(v: T) → Atomic<T> ! ∅ { }
  ƒ load(&self, o: AtomicOrdering) → T ! ∅ { }
  ƒ store(&self, v: T, o: AtomicOrdering) ! ∅ { }
  ƒ swap(&self, v: T, o: AtomicOrdering) → T ! ∅ { }
  ƒ fetch_add(&self, v: T, o: AtomicOrdering) → T ! ∅ { }
  ƒ fetch_sub(&self, v: T, o: AtomicOrdering) → T ! ∅ { }
  ƒ compare_exchange(&self, cur: T, new: T, s: AtomicOrdering, f: AtomicOrdering) → Result<T, T> ! ∅ { }
}
#lang(mutex)
▢ Mutex<T, L> { v: T }
⊐ <T, L> Mutex<T, L> {
  ƒ new(v: T) → Mutex<T, L> ! ∅ { }
  ƒ with<R: Send, Arg: Send>(&self, f: ƒ(&!T, Arg) → R ! {poly}, a: Arg) → R ! {poly, lock(L)} { }
}
#lang(cell)
▢ Cell<T> { v: T }
⊐ <T> Cell<T> {
  ƒ new(v: T) → Cell<T> ! ∅ { }
  ƒ set(&self, x: T) ! ∅ { }
  ƒ get(&self) → T ! ∅ { }
}
#lang(drop)
⊏ Drop { ƒ drop(&!self) ! ∅; }
▢ Buf { n: i32 }
⊐ Drop for Buf { ƒ drop(&!self) ! ∅ { } }
ƒ mk_buf() → Buf ! ∅ { }
▢ Guard { ◈ inner: Buf, ◈ n: i32 }
⊐ Drop for Guard { ƒ drop(&!self) ! ∅ { } }
ƒ mk_guard() → Guard ! ∅ { }
#lang(secret)
▢ Secret<T> { v: T }
⊐ <T> Secret<T> { ƒ declassify(self) → T ! ∅ { } }
#lang(cap)
▢ Cap<T> { v: T }
▢ Fs { x: i32 }
▢ Net { x: i32 }
▢ Env { x: i32 }
▢ Clock { x: i32 }
▢ Alloc { x: i32 }
▢ Out { x: i32 }
// stdin (Seed 1.0 G5): capability đọc đầu vào chuẩn; `Cap<In>::read_all` đọc NGUYÊN stdin tới EOF (lỗi ⇒ `Err`)
▢ In { x: i32 }
// stderr riêng. Tên `ErrOut` (không phải `Err`) vì `Err` là biến thể của `Result` và sẽ bị che/che khuất (xem DOGFOOD #11).
▢ ErrOut { x: i32 }
▢ Host { x: i32 }
#lang(arena)
▢ Arena { x: i32 }
// Vec<'a, T> (ADR-032 phụ lục A, TCB): mảng tăng trưởng nằm trong MỘT Arena. Giữ `&'a Arena` CHIA SẺ (ADR-038 hướng (ii), Seed 1.0 R6): nhiều Vec/Text dùng chung một Arena; `reset` (`&!`) bị M6 chặn khi còn Vec sống. Không Drop (arena giải phóng cả khối); T không được
// cần drop (E0318). Phần tử đọc qua `as_slice` (kiểm biên có sẵn). Trường private + literal ngoài lib/core bị cấm (E0313).
#lang(vec)
▢ Vec<'a, T> { arena: &'a Arena, ptr: *μ T, len: usize, cap: usize }
▢ File { x: i32 }
⊔ IoError { NotFound, Denied, Invalid, Other }
⊐ <T> [T] { ƒ len(&self) → usize ! ∅ { } }
⊐ File {
  ƒ len(&self) → usize ! ∅ { }
  // nội dung tệp: bộ nhớ RÒ RỈ CÓ CHỦ ĐÍCH sống tới hết tiến trình (gt-rt) nên là `'static` — có thể lưu trong cấu trúc dài hơn `File` (Seed 1.0 G10)
  ƒ bytes(&self) → &'static [u8] ! ∅ { }
}
⊐ <T> Option<T> {
  ƒ is_some(&self) → bool ! ∅ { }
  ƒ unwrap(self) → T ! ∅ ⊳ self.is_some() { }
}
ƒ shl(x: u32, n: u32) → u32 ! ∅ ⊳ n < 32 { }
ƒ shr(x: u32, n: u32) → u32 ! ∅ ⊳ n < 32 { }
// phép bit trên u32 (Q9: là HÀM của lib/core, không phải toán tử): AND/OR/XOR/NOT, xoay phải/trái; xoay và dịch đòi n < 32 (⊳)
ƒ band(a: u32, b: u32) → u32 ! ∅ { }
ƒ bor(a: u32, b: u32) → u32 ! ∅ { }
ƒ bxor(a: u32, b: u32) → u32 ! ∅ { }
ƒ bnot(a: u32) → u32 ! ∅ { }
ƒ rotr(x: u32, n: u32) → u32 ! ∅ ⊳ n < 32 { }
ƒ rotl(x: u32, n: u32) → u32 ! ∅ ⊳ n < 32 { }
⊐ Cap<Fs> {
  ƒ read(&self, p: &str) → File ! {io} { }
  ƒ open(&self, p: &str) → Result<File, IoError> ! {io} { }
  ƒ sub(&self, p: &str) → Cap<Fs> ! {io} { }
  // ghi NGUYÊN tệp (tạo/cắt cụt); lỗi ⇒ `Err` (Seed 1.0 G6)
  ƒ write(&self, p: &str, b: &[u8]) → Result<(), IoError> ! {io} { }
}
⊐ Cap<Net> { ƒ connect(&self, h: &str) → File ! {io} { } }
⊐ Cap<Env> {
  ƒ var(&self, n: &str) → usize ! {io} { }
  ƒ arg(&self, i: usize) → &str ! {io} { }
  ƒ arg_count(&self) → usize ! {io} { }
}
⊐ Cap<Out> {
  ƒ write_u64(&self, n: u64) ! {io} { }
  ƒ write_str(&self, s: &str) ! {io} { }
  ƒ write_bytes(&self, b: &[u8]) ! {io} { }
}
⊐ Cap<In> {
  ƒ read_all(&self) → Result<File, IoError> ! {io} { }
}
⊐ Cap<ErrOut> {
  ƒ write_u64(&self, n: u64) ! {io} { }
  ƒ write_str(&self, s: &str) ! {io} { }
}
⊐ Cap<Clock> { ƒ now(&self) → u64 ! {io} { } }
⊐ Cap<Alloc> { ƒ arena(&self) → Arena ! {mem} { } }
⊐ Host { ƒ fs() → Cap<Fs> ! {io} { } }
⊐ Arena { ƒ new() → Arena ! {mem} { } ƒ alloc<T>(&self, v: T) → &T ! {mem} { } ƒ reset(&!self) ! {mem} { } }
⊐ <'a, T> Vec<'a, T> {
  ƒ new(a: &'a Arena) → Vec<'a, T> ! {mem} { }
  ƒ push(&!self, x: T) ! {mem} { }
  ƒ reserve(&!self, n: usize) ! {mem} { }
  ƒ len(&self) → usize ! ∅ { }
  ƒ as_slice(&self) → &[T] ! ∅ { }
  ƒ as_mut_slice(&!self) → &![T] ! ∅ { }
  // cắt bớt còn `min(n, len)` phần tử (không bao giờ tăng; T không cần drop nên không chạy destructor) — Seed 1.0 G3
  ƒ truncate(&!self, n: usize) ! ∅ { }
}
// Text<'a> (ADR-035, Q72, TCB): bộ đệm UTF-8 trên MỘT Arena, DỰNG rồi ĐÓNG BĂNG. Bất biến UTF-8 chỉ do các intrinsic dưới đây bảo đảm
// (đường tạo hợp lệ: `new` rỗng, `push_str` (&str hợp lệ), `push_char` (char hợp lệ), `push_utf8`/`from_utf8` (KIỂM RFC 3629 bằng runtime)).
// Khung nhìn `&str`/`&[u8]` lấy bằng `&self` nên dựng thêm (`&!self`) làm chúng vô hiệu (M6 chặn tĩnh). Trường private; literal bị E0313.
#lang(text)
▢ Text<'a> { bytes: Vec<'a, u8> }
⊐ <'a> Text<'a> {
  ƒ new(a: &'a Arena) → Text<'a> ! {mem} { }
  ƒ push_str(&!self, s: &str) ! {mem} { }
  ƒ push_char(&!self, c: char) ! {mem} { }
  ƒ push_utf8(&!self, b: &[u8]) → bool ! {mem} { }
  ƒ from_utf8(a: &'a Arena, b: &[u8]) → Option<Text<'a>> ! {mem} { }
  ƒ len(&self) → usize ! ∅ { }
  ƒ as_str(&self) → &str ! ∅ { }
  ƒ as_bytes(&self) → &[u8] ! ∅ { }
}
// cắt `&str` TẠI BIÊN KÝ TỰ: `from ≤ to ≤ len` và hai đầu không nằm giữa một ký tự nhiều byte; sai ⇒ abort `slice_range`
// f64 (ADR-035 §B, TCB): số học IEEE-754 thuần (không fast-math); `==`/`≠` cấm (D4); `as` sang số nguyên cấm (E0319): chỉ `to_i64` trả `Option`.
// M7 coi giá trị f64 là BÍ ẨN. `sqrt` làm tròn đúng (IEEE), NaN cho số âm; `to_bits`/`from_bits` là bitcast; `is_nan` thay cho `x != x`.
⊐ f64 {
  ƒ sqrt(self) → f64 ! ∅ { }
  ƒ to_i64(self) → Option<i64> ! ∅ { }
  ƒ to_bits(self) → u64 ! ∅ { }
  ƒ is_nan(self) → bool ! ∅ { }
}
⊐ str {
  // khung nhìn byte của chuỗi (cùng bộ nhớ, không sao chép) — Seed 1.0 G4
  ƒ as_bytes(&self) → &[u8] ! ∅ { }
  ƒ len(&self) → usize ! ∅ { }
  ƒ slice(&self, from: usize, to: usize) → &str ! ∅ { }
}
▦ core {
  ◈ ƒ abort(msg: &str) → ! ! {div} { }
  ◈ ƒ exit(code: u32) → ! ! {div} { }
  // bitcast u64 → f64 (mẫu bit IEEE-754; mọi mẫu hợp lệ, kể cả NaN/±∞/dưới chuẩn)
  ◈ ƒ f64_from_bits(b: u64) → f64 ! ∅ { }
  // nhiên liệu của vòng lặp: gọi SAU vòng lặp `⟳ fuel > 0 … ↓ fuel`; `fuel == 0` (cạn) ⇒ abort `fuel_exhausted` (check lúc chạy, M7 có thể xoá, ghi chú N0905)
  ◈ ƒ fuel_left(n: u64) ! ∅ { }
  // KHÔNG ◈: hàm riêng của module, chỉ để test E0203 (quy tắc nhìn thấy) của gt-resolve dùng chính prelude thật
  ƒ hidden() ! ∅ { }
}
ƒ root_fs() → Cap<Fs> ! ∅ { }
ƒ root_net() → Cap<Net> ! ∅ { }
ƒ root_env() → Cap<Env> ! ∅ { }
ƒ root_clock() → Cap<Clock> ! ∅ { }
ƒ root_alloc() → Cap<Alloc> ! ∅ { }
ƒ root_out() → Cap<Out> ! ∅ { }
ƒ root_in() → Cap<In> ! ∅ { }
ƒ root_err() → Cap<ErrOut> ! ∅ { }
ƒ raw_read(p: usize) → i32 ! ∅ { }
