// Prelude của `gritc` (giả lập `lib/core`; M12 thay bằng thư viện lõi thật). Thân hàm của prelude KHÔNG được kiểm
// (intrinsic trusted, D22); chỉ chữ ký và hợp đồng có nghĩa. Nguồn cho gritc; test của gt-types dùng bản trùng
// (gt-driver có test khoá hai bản bằng nhau).
#lang(option)
⊔ Option<T> { None, Some(T) }
⊔ Result<T, E> { Ok(T), Err(E) }
#lang(range)
▢ Range<T> { start: T, end: T }
#lang(range_inclusive)
▢ RangeInclusive<T> { start: T, end: T }
#lang(copy)
⊏ Copy { }
#lang(send)
⊏ Send { }
ƒ spawn<A: Send>(f: ƒ(A) ! {detach}, a: A) ! {detach} { }
#lang(sync)
⊏ Sync { }
#lang(ordering)
⊔ Ordering { Relaxed, Acquire, Release, AcqRel, SeqCst }
#lang(atomic_int)
⊏ AtomicInt { }
⊐ AtomicInt for bool { }
⊐ AtomicInt for i32 { }
⊐ AtomicInt for u32 { }
⊐ AtomicInt for i64 { }
⊐ AtomicInt for u64 { }
⊐ AtomicInt for usize { }
#lang(atomic)
▢ Atomic<T: AtomicInt> { v: T }
⊐ <T: AtomicInt> Atomic<T> {
  ƒ new(v: T) → Atomic<T> ! ∅ { }
  ƒ load(&self, o: Ordering) → T ! ∅ { }
  ƒ store(&self, v: T, o: Ordering) ! ∅ { }
  ƒ swap(&self, v: T, o: Ordering) → T ! ∅ { }
  ƒ fetch_add(&self, v: T, o: Ordering) → T ! ∅ { }
  ƒ fetch_sub(&self, v: T, o: Ordering) → T ! ∅ { }
  ƒ compare_exchange(&self, cur: T, new: T, s: Ordering, f: Ordering) → Result<T, T> ! ∅ { }
}
#lang(mutex)
▢ Mutex<T, L> { v: T }
⊐ <T, L> Mutex<T, L> {
  ƒ new(v: T) → Mutex<T, L> ! ∅ { }
  ƒ with<R: Send, Arg: Send>(&self, f: ƒ(&!T, Arg) → R ! {poly}, a: Arg) → R ! {poly, lock(L)} { }
}
#lang(cell)
▢ Cell<T> { v: T }
⊐ <T> Cell<T> {
  ƒ new(v: T) → Cell<T> ! ∅ { }
  ƒ set(&self, x: T) ! ∅ { }
  ƒ get(&self) → T ! ∅ { }
}
#lang(drop)
⊏ Drop { ƒ drop(&!self) ! ∅; }
▢ Buf { n: i32 }
⊐ Drop for Buf { ƒ drop(&!self) ! ∅ { } }
ƒ mk_buf() → Buf ! ∅ { }
▢ Guard { ◈ inner: Buf, ◈ n: i32 }
⊐ Drop for Guard { ƒ drop(&!self) ! ∅ { } }
ƒ mk_guard() → Guard ! ∅ { }
#lang(secret)
▢ Secret<T> { v: T }
⊐ <T> Secret<T> { ƒ declassify(self) → T ! ∅ { } }
#lang(cap)
▢ Cap<T> { v: T }
▢ Fs { x: i32 }
▢ Net { x: i32 }
▢ Env { x: i32 }
▢ Clock { x: i32 }
▢ Alloc { x: i32 }
▢ Out { x: i32 }
// stderr riêng. Tên `ErrOut` (không phải `Err`) vì `Err` là biến thể của `Result` và sẽ bị che/che khuất (xem DOGFOOD #11).
▢ ErrOut { x: i32 }
▢ Host { x: i32 }
#lang(arena)
▢ Arena { x: i32 }
▢ File { x: i32 }
⊔ IoError { NotFound, Denied, Invalid, Other }
⊐ <T> [T] { ƒ len(&self) → usize ! ∅ { } }
⊐ File {
  ƒ len(&self) → usize ! ∅ { }
  ƒ bytes(&self) → &[u8] ! ∅ { }
}
⊐ <T> Option<T> {
  ƒ is_some(&self) → bool ! ∅ { }
  ƒ unwrap(self) → T ! ∅ ⊳ self.is_some() { }
}
ƒ shl(x: u32, n: u32) → u32 ! ∅ ⊳ n < 32 { }
ƒ shr(x: u32, n: u32) → u32 ! ∅ ⊳ n < 32 { }
⊐ Cap<Fs> {
  ƒ read(&self, p: &str) → File ! {io} { }
  ƒ open(&self, p: &str) → Result<File, IoError> ! {io} { }
  ƒ sub(&self, p: &str) → Cap<Fs> ! {io} { }
}
⊐ Cap<Net> { ƒ connect(&self, h: &str) → File ! {io} { } }
⊐ Cap<Env> {
  ƒ var(&self, n: &str) → usize ! {io} { }
  ƒ arg(&self, i: usize) → &str ! {io} { }
  ƒ arg_count(&self) → usize ! {io} { }
}
⊐ Cap<Out> {
  ƒ write_u64(&self, n: u64) ! {io} { }
  ƒ write_str(&self, s: &str) ! {io} { }
}
⊐ Cap<ErrOut> {
  ƒ write_u64(&self, n: u64) ! {io} { }
  ƒ write_str(&self, s: &str) ! {io} { }
}
⊐ Cap<Clock> { ƒ now(&self) → u64 ! {io} { } }
⊐ Cap<Alloc> { ƒ arena(&self) → Arena ! {mem} { } }
⊐ Host { ƒ fs() → Cap<Fs> ! {io} { } }
⊐ Arena { ƒ new() → Arena ! {mem} { } ƒ alloc<T>(&self, v: T) → &T ! {mem} { } ƒ reset(&!self) ! {mem} { } }
▦ core {
  ◈ ƒ abort(msg: &str) → ! ! {div} { }
  ◈ ƒ exit(code: u32) → ! ! {div} { }
  // nhiên liệu của vòng lặp: gọi SAU vòng lặp `⟳ fuel > 0 … ↓ fuel`; `fuel == 0` (cạn) ⇒ abort `fuel_exhausted` (check lúc chạy, M7 có thể xoá, ghi chú N0905)
  ◈ ƒ fuel_left(n: u64) ! ∅ { }
  // KHÔNG ◈: hàm riêng của module, chỉ để test E0203 (quy tắc nhìn thấy) của gt-resolve dùng chính prelude thật
  ƒ hidden() ! ∅ { }
}
ƒ root_fs() → Cap<Fs> ! ∅ { }
ƒ root_net() → Cap<Net> ! ∅ { }
ƒ root_env() → Cap<Env> ! ∅ { }
ƒ root_clock() → Cap<Clock> ! ∅ { }
ƒ root_alloc() → Cap<Alloc> ! ∅ { }
ƒ root_out() → Cap<Out> ! ∅ { }
ƒ root_err() → Cap<ErrOut> ! ∅ { }
ƒ raw_read(p: usize) → i32 ! ∅ { }
