⊐ Ord for char {
  ƒ cmp(&self, o: &Self) → Ordering ! ∅ {
    ⎇ *self < *o { Ordering::Less } ⇝ { ⎇ *self > *o { Ordering::Greater } ⇝ { Ordering::Equal } }
  }
}

⊐ Ord for bool {
  ƒ cmp(&self, o: &Self) → Ordering ! ∅ {
    ⎇ *self { ⎇ *o { Ordering::Equal } ⇝ { Ordering::Greater } } ⇝ { ⎇ *o { Ordering::Less } ⇝ { Ordering::Equal } }
  }
}
