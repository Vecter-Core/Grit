⊐ Ord for isize {
  ƒ cmp(&self, o: &Self) → Ordering ! ∅ {
    ⎇ *self < *o { Ordering::Less } ⇝ { ⎇ *self > *o { Ordering::Greater } ⇝ { Ordering::Equal } }
  }
