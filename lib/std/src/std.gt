// std (Q84/Q86 bước (i), ADR-040 mở khoá): thư viện chuẩn viết bằng Grit THƯỜNG (qua cùng cổng của gritc như mã người dùng), KHÔNG thêm intrinsic nào.
// Mọi hàm `! ∅`; tham số hàm là con trỏ hàm `ƒ(T) → U ! ∅` (hàm có hiệu ứng khác ∅ chưa dùng được với `map`/`and_then`: KNOWN_LIMITATIONS).
// Tên hàm tự do `min`/`max` là hàm của module `std` (gọi `std::min`); phương thức của `Option`/`Result`/`Ordering` gọi trực tiếp.
// Kiểm thử: crates/gt-driver/tests/std_lib.rs (bản tham chiếu Rust độc lập + bộ sinh ba nguồn).

// ---------------------------------------------------------------- Ordering
⊐ Ordering {
  ƒ reverse(self) → Ordering ! ∅ {
    ⌥ self { Ordering::Less ↦ Ordering::Greater, Ordering::Equal ↦ Ordering::Equal, Ordering::Greater ↦ Ordering::Less }
  }
  // `a.cmp(b).then(c.cmp(d))`: nếu bằng thì lấy `o`
  ƒ then(self, o: Ordering) → Ordering ! ∅ {
    ⌥ self { Ordering::Equal ↦ o, Ordering::Less ↦ Ordering::Less, Ordering::Greater ↦ Ordering::Greater }
  }
  ƒ is_lt(self) → bool ! ∅ { ⌥ self { Ordering::Less ↦ true, _ ↦ false } }
  ƒ is_eq(self) → bool ! ∅ { ⌥ self { Ordering::Equal ↦ true, _ ↦ false } }
  ƒ is_gt(self) → bool ! ∅ { ⌥ self { Ordering::Greater ↦ true, _ ↦ false } }
}

// ---------------------------------------------------------------- Option
// `is_some`/`unwrap` là intrinsic của prelude (unwrap đòi ⊳ is_some, FB-6: KHÔNG nới E0902). Các hàm dưới khớp mẫu qua tham chiếu (ADR-040) hoặc theo giá trị.
⊐ <T> Option<T> {
  ƒ is_none(&self) → bool ! ∅ { ⌥ self { Some(_) ↦ false, None ↦ true } }
  ƒ unwrap_or(self, d: T) → T ! ∅ { ⌥ self { Some(v) ↦ v, None ↦ d } }
  ƒ map<U>(self, f: ƒ(T) → U ! ∅) → Option<U> ! ∅ { ⌥ self { Some(v) ↦ Some(f(v)), None ↦ None } }
  ƒ and_then<U>(self, f: ƒ(T) → Option<U> ! ∅) → Option<U> ! ∅ { ⌥ self { Some(v) ↦ f(v), None ↦ None } }
  ƒ or(self, o: Option<T>) → Option<T> ! ∅ { ⌥ self { Some(v) ↦ Some(v), None ↦ o } }
  ƒ ok_or<E>(self, e: E) → Result<T, E> ! ∅ { ⌥ self { Some(v) ↦ Ok(v), None ↦ Err(e) } }
}

// ---------------------------------------------------------------- Result
⊐ <T, E> Result<T, E> {
  ƒ is_ok(&self) → bool ! ∅ { ⌥ self { Ok(_) ↦ true, Err(_) ↦ false } }
  ƒ is_err(&self) → bool ! ∅ { ⌥ self { Ok(_) ↦ false, Err(_) ↦ true } }
  ƒ unwrap_or(self, d: T) → T ! ∅ { ⌥ self { Ok(v) ↦ v, Err(_) ↦ d } }
  ƒ map<U>(self, f: ƒ(T) → U ! ∅) → Result<U, E> ! ∅ { ⌥ self { Ok(v) ↦ Ok(f(v)), Err(e) ↦ Err(e) } }
  ƒ map_err<F>(self, f: ƒ(E) → F ! ∅) → Result<T, F> ! ∅ { ⌥ self { Ok(v) ↦ Ok(v), Err(e) ↦ Err(f(e)) } }
  ƒ and_then<U>(self, f: ƒ(T) → Result<U, E> ! ∅) → Result<U, E> ! ∅ { ⌥ self { Ok(v) ↦ f(v), Err(e) ↦ Err(e) } }
  ƒ ok(self) → Option<T> ! ∅ { ⌥ self { Ok(v) ↦ Some(v), Err(_) ↦ None } }
  ƒ err(self) → Option<E> ! ∅ { ⌥ self { Ok(_) ↦ None, Err(e) ↦ Some(e) } }
}

// ---------------------------------------------------------------- min / max theo Ord (bên trái khi bằng ⇒ ổn định, như `std::cmp::min`/`max` của Rust: min lấy a khi bằng, max lấy b khi bằng)
◈ ƒ min<T: Ord + Copy>(a: T, b: T) → T ! ∅ { ⌥ b.cmp(&a) { Ordering::Less ↦ b, _ ↦ a } }
◈ ƒ max<T: Ord + Copy>(a: T, b: T) → T ! ∅ { ⌥ b.cmp(&a) { Ordering::Less ↦ a, _ ↦ b } }

// ================================================================ Seed 1.0 S2: Vec, byte, số (hợp nhất vào module `std` để người dùng gọi `std::…`)
// std_vec (Seed 1.0 S2, G3): API của `Vec<'a, T>` viết bằng Grit THƯỜNG trên intrinsic `new/push/reserve/len/as_slice/as_mut_slice/truncate` của prelude.
// Mọi phần tử phải `Copy` (Vec trên Arena không chạy destructor, E0318). Hàm đòi điều kiện dùng `⊳` (kiểm lúc chạy nếu không chứng minh được: abort
// `precondition`), KHÔNG trả `Option` giả. Kiểm thử: crates/gt-driver/tests/std2_lib.rs (mô hình Rust độc lập ≡ thông dịch ≡ exe).

⊐ <'a, T: Copy> Vec<'a, T> {
  ƒ is_empty(&self) → bool ! ∅ { self.len() == 0usize }
  // phần tử thứ `i` (None nếu ngoài biên)
  ƒ get(&self, i: usize) → Option<T> ! ∅ {
    s ≔ self.as_slice();
    ⎇ i < s.len() { Some(s[i]) } ⇝ { None }
  }
  ƒ first(&self) → Option<T> ! ∅ { self.get(0usize) }
  ƒ last(&self) → Option<T> ! ∅ {
    n ≔ self.len();
    ⎇ n == 0usize { None } ⇝ { self.get(n - 1usize) }
  }
  // bỏ và trả phần tử cuối
  ƒ pop(&!self) → Option<T> ! ∅ {
    n ≔ self.len();
    ⎇ n == 0usize { None } ⇝ {
      v ≔ self.as_slice()[n - 1usize];
      self.truncate(n - 1usize);
      Some(v)
    }
  }
  ƒ clear(&!self) ! ∅ { self.truncate(0usize); }
  // thêm mọi phần tử của `s` vào cuối
  ƒ extend_from_slice(&!self, s: &[T]) ! {mem} {
    μi ≔ 0usize;
    ⟳ i < s.len() ↓ s.len() - i {
      self.push(s[i]);
      i ← i + 1usize;
    }
  }
  // chèn `x` tại `min(i, len)` (dịch phần sau sang phải). Không dùng `⊳ i ≤ len`: hợp đồng trên `&!self` không kiểm được lúc chạy (E0902) nên sẽ đòi
  // chứng minh ở MỌI chỗ gọi; kẹp chỉ số làm hàm TOÀN PHẦN, không bao giờ abort
  ƒ insert(&!self, i: usize, x: T) ! {mem} {
    n ≔ self.len();
    at_ ≔ ⎇ i < n { i } ⇝ { n };
    self.push(x);
    μj ≔ n;
    ⟳ j > at_ ↓ j {
      μs ≔ self.as_mut_slice();
      s[j] ← s[j - 1usize];
      j ← j - 1usize;
    }
    μs2 ≔ self.as_mut_slice();
    s2[at_] ← x;
  }
  // bỏ và trả phần tử thứ `i` (dịch phần sau sang trái); None nếu `i ≥ len`
  ƒ remove(&!self, i: usize) → Option<T> ! ∅ {
    n ≔ self.len();
    ⎇ i < n {
      v ≔ self.as_slice()[i];
      μj ≔ i;
      ⟳ j + 1usize < n ↓ n - j {
        μs ≔ self.as_mut_slice();
        s[j] ← s[j + 1usize];
        j ← j + 1usize;
      }
      self.truncate(n - 1usize);
      Some(v)
    } ⇝ { None }
  }
}

⊐ <'a, T: Ord + Copy> Vec<'a, T> {
  ƒ contains(&self, x: &T) → bool ! ∅ {
    s ≔ self.as_slice();
    μi ≔ 0usize;
    μfound ≔ false;
    ⟳ i < s.len() ↓ s.len() - i {
      ⎇ s[i].cmp(x).is_eq() { found ← true; } ⇝ { }
      i ← i + 1usize;
    }
    found
  }
}

// std_bytes (Seed 1.0 S2, G4/G11/G12): thao tác trên BYTE — tìm kiếm, cắt khoảng trắng ASCII, phân tích số nguyên (trả `Result`, không abort), in số có dấu/hex,
// số học kiểm tràn. Viết bằng Grit THƯỜNG trên `str::as_bytes`, lát byte và `Cap<Out>`/`Vec<'a, u8>` của prelude. Quy ước: vị trí là BYTE; mọi hàm TOÀN PHẦN
// (không abort vì đầu vào; chỉ các kiểm tra tràn/biên mà bộ giải chưa chứng minh được là kiểm lúc chạy và không bao giờ kích hoạt với đầu vào hợp lệ).
// Vòng lặp luôn có `↓` (M8): "thoát sớm" bằng cách đặt chỉ số về cuối. Kiểm thử: crates/gt-driver/tests/std2_lib.rs (mô hình Rust độc lập ≡ thông dịch ≡ exe).

// lỗi phân tích số nguyên: Empty (không có ký tự), Invalid (có ký tự không phải chữ số), Overflow (ngoài miền kiểu). Ưu tiên: Empty > Invalid > Overflow.
◈ ⊔ ParseError { Empty, Invalid, Overflow }

// ký tự khoảng trắng ASCII: ` `, `\t`, `\n`, `\r`
◈ ƒ is_ascii_ws(c: u8) → bool ! ∅ { c == 32u8 ∨ c == 9u8 ∨ c == 10u8 ∨ c == 13u8 }

// các chữ số thập phân của `n` căn PHẢI trong `buf_` (24 byte); trả chỉ số bắt đầu (0 ở đầu không in; n = 0 ⇒ một chữ số `0`)
◈ ƒ fmt_u64(buf_: &![u8; 24], n: u64) → usize ! ∅ {
  μi ≔ 24usize;
  μm ≔ n;
  ⟳ i > 4usize ↓ i {
    i ← i - 1usize;
    buf_[i] ← 48u8 + ((m % 10u64) as u8);
    m ← m / 10u64;
  }
  μstart ≔ 23usize;
  μj ≔ 23usize;
  ⟳ j > 4usize ↓ j {
    j ← j - 1usize;
    ⎇ buf_[j] != 48u8 { start ← j; } ⇝ { }
  }
  start
}

// như `fmt_u64` nhưng có dấu `-` cho số âm (`i64::MIN` đúng)
◈ ƒ fmt_i64(buf_: &![u8; 24], n: i64) → usize ! ∅ {
  ⎇ n >= 0i64 { fmt_u64(buf_, n as u64) } ⇝ {
    mag_ ≔ ((0i64 - (n + 1i64)) as u64) + 1u64;
    s ≔ fmt_u64(buf_, mag_);
    ⎇ s > 0usize { buf_[s - 1usize] ← 45u8; s - 1usize } ⇝ { s }
  }
}

// 16 chữ số hex (chữ thường) của `n` căn phải trong `buf_`; trả chỉ số bắt đầu (n = 0 ⇒ một chữ số `0`)
◈ ƒ fmt_hex(buf_: &![u8; 24], n: u64) → usize ! ∅ {
  μi ≔ 24usize;
  μm ≔ n;
  ⟳ i > 8usize ↓ i {
    i ← i - 1usize;
    d ≔ (m % 16u64) as u8;
    ⎇ d < 10u8 { buf_[i] ← 48u8 + d; } ⇝ { buf_[i] ← 87u8 + d; }
    m ← m / 16u64;
  }
  μstart ≔ 23usize;
  μj ≔ 23usize;
  ⟳ j > 8usize ↓ j {
    j ← j - 1usize;
    ⎇ buf_[j] != 48u8 { start ← j; } ⇝ { }
  }
  start
}

// phân tích chuỗi chữ số thập phân (không dấu) thành u64
◈ ƒ parse_digits(b: &[u8]) → Result<u64, ParseError> ! ∅ {
  ⎇ b.len() == 0usize { Err(ParseError::Empty) } ⇝ {
    μi ≔ 0usize;
    μbad ≔ false;
    ⟳ i < b.len() ↓ b.len() - i {
      c ≔ b[i];
      ⎇ c < 48u8 ∨ c > 57u8 { bad ← true; } ⇝ { }
      i ← i + 1usize;
    }
    ⎇ bad { Err(ParseError::Invalid) } ⇝ {
      μk ≔ 0usize;
      μv ≔ 0u64;
      μover ≔ false;
      ⟳ k < b.len() ↓ b.len() - k {
        d ≔ (b[k] - 48u8) as u64;
        ⎇ v > 1844674407370955161u64 ∨ (v == 1844674407370955161u64 ∧ d > 5u64) { over ← true; k ← b.len(); } ⇝ {
          v ← v * 10u64 + d;
          k ← k + 1usize;
        }
      }
      ⎇ over { Err(ParseError::Overflow) } ⇝ { Ok(v) }
    }
  }
}

// chỉ số của byte không-khoảng-trắng đầu tiên (len nếu không có)
◈ ƒ first_non_ws(b: &[u8]) → usize ! ∅ {
  n ≔ b.len();
  μa ≔ 0usize;
  μfirst_ ≔ n;
  ⟳ a < n ↓ n - a {
    ⎇ is_ascii_ws(b[a]) { a ← a + 1usize; } ⇝ { first_ ← a; a ← n; }
  }
  first_
}

// chỉ số ngay SAU byte không-khoảng-trắng cuối cùng (0 nếu không có). Luôn giảm `e` mỗi vòng (M8 không chứng minh được gán hằng làm biến thể giảm).
◈ ƒ end_after_last_non_ws(b: &[u8]) → usize ! ∅ {
  μe ≔ b.len();
  μlast_ ≔ 0usize;
  μfound ≔ false;
  ⟳ e > 0usize ↓ e {
    ⎇ ¬found ∧ ¬is_ascii_ws(b[e - 1usize]) { last_ ← e; found ← true; } ⇝ { }
    e ← e - 1usize;
  }
  last_
}

⊐ [u8] {
  ƒ starts_with(&self, p: &[u8]) → bool ! ∅ {
    ⎇ p.len() > self.len() { false } ⇝ {
      μi ≔ 0usize;
      μok ≔ true;
      ⟳ i < p.len() ↓ p.len() - i {
        ⎇ self[i] != p[i] { ok ← false; } ⇝ { }
        i ← i + 1usize;
      }
      ok
    }
  }
  ƒ ends_with(&self, p: &[u8]) → bool ! ∅ {
    ⎇ p.len() > self.len() { false } ⇝ {
      off_ ≔ self.len() - p.len();
      μi ≔ 0usize;
      μok ≔ true;
      ⟳ i < p.len() ↓ p.len() - i {
        ⎇ self[off_ + i] != p[i] { ok ← false; } ⇝ { }
        i ← i + 1usize;
      }
      ok
    }
  }
  // bằng nhau từng byte (`==` KHÔNG có cho lát; dùng hàm này)
  ƒ equals(&self, o: &[u8]) → bool ! ∅ { self.len() == o.len() ∧ self.starts_with(o) }
  // vị trí byte đầu tiên bằng `b` tại hoặc sau `from_`
  ƒ find_byte(&self, from_: usize, b: u8) → Option<usize> ! ∅ {
    n ≔ self.len();
    μi ≔ from_;
    μr ≔ None;
    ⟳ i < n ↓ n - i {
      ⎇ self[i] == b { r ← Some(i); i ← n; } ⇝ { i ← i + 1usize; }
    }
    r
  }
  // vị trí byte `b` đầu tiên tại hoặc sau `from`, hoặc `max(len, from)` nếu không có. Hậu điều kiện `result >= from` cho phép vòng lặp tách dòng
  // `⟳ pos < n ↓ n - pos { end ≔ b.find_byte_or_end(pos, 10u8); …; pos ← end + 1usize; }` được M8 chứng minh dừng
  ƒ find_byte_or_end(&self, from_: usize, b: u8) → usize ! ∅ ⊲ result >= from_ {
    n ≔ self.len();
    μi ≔ from_;
    μr ≔ ⎇ from_ > n { from_ } ⇝ { n };
    ⟳ i < n {
      ⎇ self[i] == b { r ← i; i ← n; } ⇝ { i ← i + 1usize; }
    }
    r
  }
  // vị trí đầu tiên của dãy `p` (mẫu rỗng ⇒ Some(0)); tìm ngây thơ O(n·m)
  ƒ find(&self, p: &[u8]) → Option<usize> ! ∅ {
    n ≔ self.len();
    m ≔ p.len();
    μi ≔ 0usize;
    μr ≔ None;
    ⟳ i < n ↓ n - i {
      ⎇ i + m <= n ∧ self[i..i + m].starts_with(p) { r ← Some(i); i ← n; } ⇝ { i ← i + 1usize; }
    }
    ⎇ m == 0usize { Some(0usize) } ⇝ { r }
  }
  // bỏ khoảng trắng ASCII ở hai đầu
  ƒ trim_ascii(&self) → &[u8] ! ∅ {
    first_ ≔ first_non_ws(self);
    last_ ≔ end_after_last_non_ws(self);
    ⎇ first_ < last_ { &self[first_..last_] } ⇝ { &self[0usize..0usize] }
  }
  // u64 thập phân không dấu
  ƒ parse_u64(&self) → Result<u64, ParseError> ! ∅ { parse_digits(self) }
  // i64 thập phân với `-` tuỳ chọn (không có `+`)
  ƒ parse_i64(&self) → Result<i64, ParseError> ! ∅ {
    ⎇ self.len() > 0usize ∧ self[0usize] == 45u8 {
      ⌥ parse_digits(&self[1usize..self.len()]) {
        Ok(m) ↦ {
          ⎇ m > 9223372036854775808u64 { Err(ParseError::Overflow) } ⇝ {
            ⎇ m == 9223372036854775808u64 { Ok(0i64 - 9223372036854775807i64 - 1i64) } ⇝ { Ok(0i64 - (m as i64)) }
          }
        },
        Err(e) ↦ Err(e),
      }
    } ⇝ {
      ⌥ parse_digits(self) {
        Ok(m) ↦ {
          ⎇ m > 9223372036854775807u64 { Err(ParseError::Overflow) } ⇝ { Ok(m as i64) }
        },
        Err(e) ↦ Err(e),
      }
    }
  }
}

⊐ str {
  ƒ starts_with(&self, p: &str) → bool ! ∅ { self.as_bytes().starts_with(p.as_bytes()) }
  ƒ ends_with(&self, p: &str) → bool ! ∅ { self.as_bytes().ends_with(p.as_bytes()) }
  ƒ find(&self, p: &str) → Option<usize> ! ∅ { self.as_bytes().find(p.as_bytes()) }
  ƒ parse_u64(&self) → Result<u64, ParseError> ! ∅ { self.as_bytes().parse_u64() }
  ƒ parse_i64(&self) → Result<i64, ParseError> ! ∅ { self.as_bytes().parse_i64() }
}

// ghi số nguyên có dấu/hex/byte ra stdout và stderr
⊐ Cap<Out> {
  ƒ write_i64(&self, n: i64) ! {io} {
    μbuf_ ≔ [0u8; 24];
    s ≔ fmt_i64(&!buf_, n);
    self.write_bytes(&buf_[s..24usize]);
  }
  ƒ write_hex(&self, n: u64) ! {io} {
    μbuf_ ≔ [0u8; 24];
    s ≔ fmt_hex(&!buf_, n);
    self.write_bytes(&buf_[s..24usize]);
  }
  ƒ write_byte(&self, b: u8) ! {io} {
    μbuf_ ≔ [b; 1];
    self.write_bytes(&buf_[0usize..1usize]);
  }
}

// thêm văn bản/số vào một `Vec<u8>` (dựng bộ đệm đầu ra)
⊐ <'a> Vec<'a, u8> {
  ƒ push_str(&!self, s: &str) ! {mem} { self.extend_from_slice(s.as_bytes()); }
  ƒ push_u64(&!self, n: u64) ! {mem} {
    μbuf_ ≔ [0u8; 24];
    s ≔ fmt_u64(&!buf_, n);
    self.extend_from_slice(&buf_[s..24usize]);
  }
  ƒ push_i64(&!self, n: i64) ! {mem} {
    μbuf_ ≔ [0u8; 24];
    s ≔ fmt_i64(&!buf_, n);
    self.extend_from_slice(&buf_[s..24usize]);
  }
}

// số học kiểm tràn không abort
◈ ƒ abs_i64(x: i64) → Option<i64> ! ∅ { ⎇ x >= 0i64 { Some(x) } ⇝ { 0i64 -? x } }
◈ ƒ pow_u64(base_: u64, exp_: u32) → Option<u64> ! ∅ {
  μr ≔ Some(1u64);
  μi ≔ 0u32;
  ⟳ i < exp_ ↓ exp_ - i {
    ⌥ r { Some(v) ↦ { r ← v *? base_; }, None ↦ { } }
    i ← i + 1u32;
  }
  r
}

// ================================================================ Seed 1.0 S2: sắp xếp, băm, HashMap (G10, G13)

// sắp xếp TẠI CHỖ theo `Ord` (heapsort: O(n log n), KHÔNG ổn định, không cần bộ đệm); phần tử `Copy`
◈ ƒ swap_at<T: Copy>(s: &![T], i: usize, j: usize) ! ∅ {
  t ≔ s[i];
  s[i] ← s[j];
  s[j] ← t;
}

// vun đống lớn-nhất con của `root_` trong s[0..n]
◈ ƒ sift_down<T: Ord + Copy>(s: &![T], root_: usize, n: usize) ! ∅ {
  μr ≔ root_;
  μk ≔ 0usize;
  ⟳ k < n ↓ n - k {
    child_ ≔ r * 2usize + 1usize;
    ⎇ child_ >= n { k ← n; } ⇝ {
      μc ≔ child_;
      ⎇ child_ + 1usize < n ∧ s[child_].cmp(&s[child_ + 1usize]).is_lt() { c ← child_ + 1usize; } ⇝ { }
      ⎇ s[r].cmp(&s[c]).is_lt() {
        swap_at(&!*s, r, c);
        r ← c;
        k ← k + 1usize;
      } ⇝ { k ← n; }
    }
  }
}

⊐ <T: Ord + Copy> [T] {
  ƒ sort(&!self) ! ∅ {
    n ≔ self.len();
    μi ≔ n / 2usize;
    ⟳ i > 0usize ↓ i {
      i ← i - 1usize;
      sift_down(&!*self, i, n);
    }
    μe ≔ n;
    ⟳ e > 1usize ↓ e {
      e ← e - 1usize;
      swap_at(&!*self, 0usize, e);
      sift_down(&!*self, 0usize, e);
    }
  }
}

// ---------------------------------------------------------------- băm
◈ ⊏ Hash { ƒ hash(&self) → u64 ! ∅; }

// băm đa thức cuộn trên byte (không có xor u64 ở Phase 1) + trộn cuối
◈ ƒ hash_bytes(b: &[u8]) → u64 ! ∅ {
  n ≔ b.len();
  μh ≔ 14695981039346656037u64;
  μi ≔ 0usize;
  ⟳ i < n ↓ n - i {
    h ← h *% 1099511628211u64 +% ((b[i] as u64) + 1u64);
    i ← i + 1usize;
  }
  h *% 11400714819323198485u64
}

⊐ Hash for u64 { ƒ hash(&self) → u64 ! ∅ { (*self) *% 11400714819323198485u64 } }
⊐ Hash for usize { ƒ hash(&self) → u64 ! ∅ { ((*self) as u64) *% 11400714819323198485u64 } }

// khoá/giá trị là lát byte (vd. nội dung `File::bytes()` hoặc một `&[u8]` nào đó): dùng được làm khoá của HashMap, so theo thứ tự từ điển byte
◈ ▢ Bytes<'a> { ◈ b: &'a [u8] }
⊐ <'a> Copy for Bytes<'a> { }
⊐ <'a> Ord for Bytes<'a> { ƒ cmp(&self, o: &Self) → Ordering ! ∅ { self.b.cmp(o.b) } }
⊐ <'a> Hash for Bytes<'a> { ƒ hash(&self) → u64 ! ∅ { hash_bytes(self.b) } }

// ---------------------------------------------------------------- HashMap
// Bảng băm địa chỉ mở, dò tuyến tính, trên Arena CHIA SẺ (R6): `slots[p]` = 0 (trống) hoặc 1 + chỉ số của entry trong `ents` (append-only; xoá = đánh dấu `live = false`,
// dọn khi nở bảng). Dựng lại (số ô = luỹ thừa 2 ≥ 4·(số khoá sống + 1), tối thiểu 8) khi (số entry + 1)·2 > số ô. Khoá `Ord` (so bằng `cmp == Equal`) + `Hash`; khoá/giá trị `Copy` (Vec trên Arena không chạy destructor).
// luỹ thừa 2 nhỏ nhất ≥ max(n, 8): số ô khi dựng lại bảng (theo số entry SỐNG, nên xoá/chèn liên tục không làm bảng phình mãi)
◈ ƒ next_cap(n: usize) → usize ! ∅ {
  μc ≔ 8usize;
  μi ≔ 0u32;
  ⟳ i < 62u32 ↓ 62u32 - i {
    ⎇ c < n { c ← c * 2usize; } ⇝ { }
    i ← i + 1u32;
  }
  c
}

▢ Ent<K, V> { k: K, v: V, h: u64, live: bool }
⊐ <K: Copy, V: Copy> Copy for Ent<K, V> { }

◈ ▢ HashMap<'a, K, V> { slots: Vec<'a, usize>, ents: Vec<'a, Ent<K, V>>, live: usize }

⊐ <'a, K: Copy + Ord + Hash, V: Copy> HashMap<'a, K, V> {
  ƒ new(a: &'a Arena) → HashMap<'a, K, V> ! {mem} {
    HashMap { slots: Vec::new(a), ents: Vec::new(a), live: 0usize }
  }
  // số khoá đang sống
  ƒ len(&self) → usize ! ∅ { self.live }
  // chỉ số trong `ents` của entry sống có khoá `k`
  ƒ find(&self, k: &K) → Option<usize> ! ∅ {
    cap_ ≔ self.slots.len();
    ⎇ cap_ == 0usize { None } ⇝ {
      h ≔ k.hash();
      μp ≔ (h % (cap_ as u64)) as usize;
      μstep ≔ 0usize;
      μr ≔ None;
      ⟳ step < cap_ ↓ cap_ - step {
        e ≔ self.slots.as_slice()[p];
        ⎇ e == 0usize { step ← cap_; } ⇝ {
          ent_ ≔ self.ents.as_slice()[e - 1usize];
          ⎇ ent_.live ∧ ent_.h == h ∧ ent_.k.cmp(k).is_eq() { r ← Some(e - 1usize); step ← cap_; } ⇝ {
            p ← (p + 1usize) % cap_;
            step ← step + 1usize;
          }
        }
      }
      r
    }
  }
  ƒ get(&self, k: &K) → Option<V> ! ∅ {
    ⌥ self.find(k) { Some(i) ↦ Some(self.ents.as_slice()[i].v), None ↦ None }
  }
  ƒ contains_key(&self, k: &K) → bool ! ∅ { ¬self.find(k).is_none() }
  // đặt `ents[idx0]` vào ô trống đầu tiên của chuỗi dò (bảng luôn còn ô trống: tải < 1/2)
  ƒ place(&!self, idx0: usize) ! ∅ {
    cap_ ≔ self.slots.len();
    h ≔ self.ents.as_slice()[idx0].h;
    μp ≔ (h % (cap_ as u64)) as usize;
    μstep ≔ 0usize;
    ⟳ step < cap_ ↓ cap_ - step {
      μs ≔ self.slots.as_mut_slice();
      ⎇ s[p] == 0usize { s[p] ← idx0 + 1usize; step ← cap_; } ⇝ {
        p ← (p + 1usize) % cap_;
        step ← step + 1usize;
      }
    }
  }
  // dựng lại với `newcap_` ô: bỏ entry đã xoá, rồi đặt lại mọi entry sống
  ƒ rebuild(&!self, newcap_: usize) ! {mem} {
    n ≔ self.ents.len();
    μw ≔ 0usize;
    μi ≔ 0usize;
    ⟳ i < n ↓ n - i {
      μes ≔ self.ents.as_mut_slice();
      e ≔ es[i];
      ⎇ e.live { es[w] ← e; w ← w + 1usize; } ⇝ { }
      i ← i + 1usize;
    }
    self.ents.truncate(w);
    self.slots.truncate(0usize);
    μz ≔ 0usize;
    ⟳ z < newcap_ ↓ newcap_ - z {
      self.slots.push(0usize);
      z ← z + 1usize;
    }
    μj ≔ 0usize;
    ⟳ j < w ↓ w - j {
      self.place(j);
      j ← j + 1usize;
    }
  }
  // thêm hoặc ghi đè
  ƒ insert(&!self, k: K, v: V) ! {mem} {
    ⌥ self.find(&k) {
      Some(i) ↦ {
        μes ≔ self.ents.as_mut_slice();
        μent_ ≔ es[i];
        ent_.v ← v;
        es[i] ← ent_;
      },
      None ↦ {
        cap_ ≔ self.slots.len();
        ⎇ (self.ents.len() + 1usize) * 2usize > cap_ {
          self.rebuild(next_cap((self.live + 1usize) * 4usize));
        } ⇝ { }
        h ≔ k.hash();
        self.ents.push(Ent { k: k, v: v, h: h, live: true });
        self.place(self.ents.len() - 1usize);
        self.live ← self.live + 1usize;
      },
    }
  }
  // xoá khoá; true nếu có
  ƒ remove(&!self, k: &K) → bool ! ∅ {
    ⌥ self.find(k) {
      Some(i) ↦ {
        μes ≔ self.ents.as_mut_slice();
        μent_ ≔ es[i];
        ent_.live ← false;
        es[i] ← ent_;
        self.live ← self.live - 1usize;
        true
      },
      None ↦ false,
    }
  }
  // duyệt: số ô entry (kể cả đã xoá) và entry thứ `i` nếu còn sống
  ƒ entry_count(&self) → usize ! ∅ { self.ents.len() }
  ƒ entry_at(&self, i: usize) → Option<(K, V)> ! ∅ {
    ⌥ self.ents.get(i) {
      Some(e) ↦ { ⎇ e.live { Some((e.k, e.v)) } ⇝ { None } },
      None ↦ None,
    }
  }
}
