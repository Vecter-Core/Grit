ƒ main() → u64 ! ∅ {
  nan ≔ core::f64_from_bits(9221120237041090560u64);
  one ≔ 1.0;
  μr ≔ 0u64;
  ⎇ nan < one { r ← r + 1u64; } ⇝ { }
  ⎇ ¬(nan < one) { r ← r + 2u64; } ⇝ { }
  ⎇ nan >= one { r ← r + 4u64; } ⇝ { }
  ⎇ ¬(nan >= one) { r ← r + 8u64; } ⇝ { }
  ⎇ ¬(nan < one) ∧ ¬(nan >= one) { r ← r + 16u64; } ⇝ { }
  ⎇ nan < one ∨ nan >= one ∨ nan > one ∨ nan <= one { r ← r + 32u64; } ⇝ { }
  c ≔ nan < one;
  d ≔ ¬c;
  ⎇ d { r ← r + 64u64; } ⇝ { }
  e ≔ ¬(nan >= one);
  ⎇ e { r ← r + 128u64; } ⇝ { }
  ⎇ (nan < one) == false { r ← r + 256u64; } ⇝ { }
  r
}
