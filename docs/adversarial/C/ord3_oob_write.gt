ƒ main() → u64 ! ∅ {
  μbig ≔ [7u8; 64];
  μsmall ≔ [1u8, 2u8];
  μvictim ≔ [5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8, 5u8];
  μs ≔ &!big[0usize..64usize];
  μt ≔ &!s[0usize..{ s ← &!small[0usize..2usize]; 60usize }];
  μi ≔ 0usize;
  ⟳ i < 60usize ↓ 60usize - i { t[i] ← 200u8; i ← i + 1usize; }
  victim[0usize] as u64 + victim[31usize] as u64 + small[0usize] as u64
}
