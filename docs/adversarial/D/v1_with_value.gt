#level("10")
▢ Lo { }
#level("20")
▢ Hi { }
■ LO: Mutex<u32, Lo> ≔ Mutex::new(0u32);
■ HI: Mutex<u32, Hi> ≔ Mutex::new(0u32);
ƒ leaf(v: &!u32, n: u32) → u32 ! ∅ { *v }
ƒ inner(v: &!u32, n: u32) → u32 ! {lock(Lo)} {
  w ≔ Mutex::with;
  w(&LO, leaf, 0u32)
}
ƒ go() → u32 ! {lock(Hi), lock(Lo)} { HI.with(inner, 0u32) }
ƒ main() → u32 ! {lock(Hi), lock(Lo)} { go() }
