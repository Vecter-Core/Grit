ƒ cls(x: f64) → u64 ! ∅ {
  ⌥ x.to_i64() { Some(v) ↦ ⎇ v < 0i64 { 2u64 } ⇝ { 1u64 }, None ↦ 0u64 }
}
ƒ val(x: f64) → i64 ! ∅ {
  ⌥ x.to_i64() { Some(v) ↦ v, None ↦ 77i64 }
}
ƒ main() → i64 ! ∅ {
  zero ≔ core::f64_from_bits(0u64);
  nan ≔ core::f64_from_bits(9221120237041090560u64);
  inf ≔ core::f64_from_bits(9218868437227405312u64);
  big ≔ 9223372036854775808.0;
  m ≔ -9223372036854775808.0;
  c1 ≔ cls(big) * 1000000u64 + cls(m) * 100000u64 + cls(nan) * 10000u64 + cls(inf) * 1000u64 + cls(-inf_neg(inf)) * 100u64;
  c1 as i64 + val(m) / 100000000i64 + val(0.0 - 0.9999) + val(-1.5)
}
ƒ inf_neg(x: f64) → f64 ! ∅ { 0.0 - x }
