{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Grit",
  "scopeName": "source.grit",
  "patterns": [
    { "name": "comment.line.double-slash.grit", "match": "//.*$" },
    { "name": "string.quoted.double.grit", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.grit", "match": "\\\\." }] },
    { "name": "keyword.control.grit", "match": "(⎇|⇝|⌥|↦|⟳|⏎|⊠|⊡|\\\\(?:if|else|match|loop|ret|break|cont))" },
    { "name": "storage.type.function.grit", "match": "(ƒ|\\\\fn)" },
    { "name": "storage.type.grit", "match": "(▢|⊔|▦|⊏|⊐|≡|□|■|\\\\(?:struct|enum|mod|trait|impl|type|const|static))" },
    { "name": "keyword.other.grit", "match": "(⇲|◈|μ|≔|←|→|↓|⊳|⊲|⋈|\\\\(?:use|pub|mut|dec|pre|post|inv))" },
    { "name": "keyword.operator.logical.grit", "match": "(∧|∨|¬|⇒|∀|∃|∈|≤|≥|≠)" },
    { "name": "support.type.grit", "match": "\\b(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f64|bool|char|str|Option|Result|Vec|Text|Arena|Cap|Secret)\\b" },
    { "name": "constant.language.grit", "match": "\\b(true|false|self|Self|None|Some|Ok|Err)\\b" },
    { "name": "constant.numeric.grit", "match": "\\b(0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9_]*(\\.[0-9_]+)?)(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f64)?\\b" }
  ]
}
