// ĐỐI CHỨNG HẸP (GÓI 5 S1.b): mỗi worker lặp dài, CHỈ ở vòng cuối mới chạm dữ liệu trong Mutex. Khi tools/tsan_inject.py --drop-locks bỏ khoá, hai luồng chỉ va chạm một lần.
// expect-result: 2
#level("10")
▢ Lo { }
■ LO: Mutex<u64, Lo> ≔ Mutex::new(0u64);
■ DONE: Atomic<u64> ≔ Atomic::new(0u64);
ƒ bump(v: &!u64, n: u64) → u64 ! ∅ { *v ← *v +% n; *v }
ƒ read(v: &!u64, n: u64) → u64 ! ∅ { *v }
ƒ worker(n: u32) ! {lock(Lo)} {
  μi ≔ 0u32;
  ⟳ i < 200000 ↓ 200000 - i {
    ⎇ i == 199999 { LO.with(bump, 1u64); } ⇝ { }
    i ← i + 1;
  }
  DONE.fetch_add(1u64, AtomicOrdering::Release);
}
ƒ main() → u64 ! {lock(Lo)} {
  spawn(worker, 0u32);
  spawn(worker, 1u32);
  μspin ≔ 0u64;
  ⟳ spin < 4000000000u64 ∧ DONE.load(AtomicOrdering::Acquire) < 2 ↓ 4000000000 - spin {
    spin ← spin + 1;
  }
  LO.with(read, 0u64)
}
