// expect: pass
// note: ADR-022 §5: x.consume(x.len()) hợp lệ
// group: G8
▢ B { v: i32 }
▢ W { b: B, n: i32 }
▢ Hm<'a> { r: &!'a i32 }
▢ Hs<'a> { r: &'a i32 }
ƒ eat(b: B) ! ∅ { }
ƒ eatw(w: W) ! ∅ { }
ƒ chk(b: B) → bool ! ∅ { true }
ƒ peek(b: &B) → i32 ! ∅ { b.v }
ƒ bump(b: &!B) ! ∅ { b.v ← b.v +% 1; }
ƒ mk() → B ! ∅ { B { v: 0 } }
ƒ mkw() → W ! ∅ { W { b: B { v: 0 }, n: 0 } }
ƒ two(a: &!i32, b: &!i32) ! ∅ { *a ← 1; *b ← 2; }
ƒ mix(a: &i32, b: &!i32) ! ∅ { *b ← *a; }
ƒ id<T>(x: T) → T ! ∅ { x }
ƒ idr<'a>(x: &'a i32) → &'a i32 ! ∅ { x }
ƒ first(a: &[i32]) → &i32 ! ∅ { &a[0] }
ƒ use_i(x: i32) ! ∅ { }
⊐ B {
  ƒ take(self) ! ∅ { }
  ƒ get(&self) → i32 ! ∅ { self.v }
  ƒ refv(&self) → &i32 ! ∅ { &self.v }
  ƒ inc(&!self) ! ∅ { self.v ← self.v +% 1; }
}
▢ V2 { n: i32 }
⊐ V2 { ƒ eat2(self, k: i32) ! ∅ { } ƒ len2(&self) → i32 ! ∅ { self.n } }
ƒ f() ! ∅ { v ≔ V2 { n: 1 }; v.eat2(v.len2()); }
