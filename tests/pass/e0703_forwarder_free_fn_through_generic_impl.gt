// expect: pass
// note: forwarder qua hàm generic tự do fwd<T: A> trong impl generic: đồ thị instance W<S>::a → fwd<S> → S::a KHÔNG có chu trình (ADR-033 phụ lục)
⊏ A { ƒ a(&self) → i32 ! ∅; }
▢ S { }
▢ W<T> { i: T }
⊐ A for S { ƒ a(&self) → i32 ! ∅ { 1 } }
ƒ fwd<T: A>(x: &T) → i32 ! ∅ { x.a() }
⊐ <T: A> A for W<T> { ƒ a(&self) → i32 ! ∅ { fwd(&self.i) } }
ƒ main() → i32 ! ∅ { w ≔ W { i: S { } }; w.a() }
