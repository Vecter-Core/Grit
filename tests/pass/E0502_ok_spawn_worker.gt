// expect: pass
// note: worker của spawn lấy khoá thấp trong khi người gọi giữ khoá cao: không lồng nên không phải E0502
#level("10")
▢ Lo { }
#level("20")
▢ Hi { }
■ LO: Mutex<u32, Lo> ≔ Mutex::new(0u32);
■ HI: Mutex<u32, Hi> ≔ Mutex::new(0u32);
ƒ leaf(v: &!u32, n: u32) → u32 ! ∅ { *v }
ƒ w(n: u32) ! {lock(Lo)} { LO.with(leaf, n); }
ƒ spawner(v: &!u32, n: u32) → u32 ! ∅ { spawn(w, 1u32); 0u32 }
ƒ go() ! {lock(Hi)} { HI.with(spawner, 0u32); }
