// expect: pass
// note: generics + ràng buộc trait + gọi phương thức (E0309 không xảy ra khi thoả)
⊏ Area { ƒ area(&self) → i32 ! ∅; }
▢ Sq { w: i32 }
⊐ Area for Sq { ƒ area(&self) → i32 ! ∅ { self.w *% self.w } }
ƒ total<T: Area>(a: &T, b: &T) → i32 ! ∅ { a.area() +% b.area() }
ƒ use_it(s: Sq) → i32 ! ∅ { total(&s, &s) }
