// expect: pass
// note: Q15 (đã duyệt): đích gán (*p).x và **pp; self làm biểu thức; ↓ trong chữ ký (biến thể đệ quy); expr_ns ở ⊳ ↓ ⋈
▢ P { x: i32 }
⊐ P {
  ƒ bump(&!self) ! ∅ { self.x ← self.x +% 1; }
}
ƒ via_ptr(p: &!P) ! ∅ { (*p).x ← 1; }
ƒ twice(pp: &!&!i32) ! ∅ { **pp ← 2; }
ƒ fact(n: u32) → u64 ! ∅ ↓ n {
  ⎇ n == 0 { 1 } ⇝ { n as u64 *% fact(n - 1) }
}
ƒ lp(x: bool, n: u32) ! ∅ ⊳ x {
  ⟳ x ↓ n ⋈ x { ⊠; }
}
ƒ nested_ok(c: bool) ! ∅ ⊳ (P { x: 1 }).x == 1 { ⟳ c ↓ (P { x: 2 }).x { ⊠; } }
