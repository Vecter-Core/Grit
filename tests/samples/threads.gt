// sample: đa luồng THẬT — Atomic + Mutex tĩnh + spawn (M10, tiêu chí (a)). Kết quả mong đợi: xem `// expect-result`.
// expect-result: 8000
#level("1")
▢ Lo { }
■ COUNT: Atomic<u64> ≔ Atomic::new(0u64);
■ SUM: Mutex<u64, Lo> ≔ Mutex::new(0u64);
ƒ add_one(v: &!u64, n: u64) → u64 ! ∅ { *v ← *v +% n; *v }
ƒ read(v: &!u64, n: u64) → u64 ! ∅ { *v }
ƒ worker(n: u32) ! {lock(Lo)} {
  μi ≔ 0u32;
  ⟳ i < 1000 ↓ 1000 - i {
    SUM.with(add_one, 1u64);
    COUNT.fetch_add(1u64, Ordering::Release);
    i ← i + 1;
  }
}
ƒ main() → u64 ! {lock(Lo)} {
  spawn(worker, 0u32);
  spawn(worker, 1u32);
  spawn(worker, 2u32);
  spawn(worker, 3u32);
  μspin ≔ 0u64;
  ⟳ spin < 4000000000u64 ∧ COUNT.load(Ordering::Acquire) < 4000 ↓ 4000000000 - spin {
    spin ← spin + 1;
  }
  COUNT.load(Ordering::SeqCst) +% SUM.with(read, 0u64)
}
