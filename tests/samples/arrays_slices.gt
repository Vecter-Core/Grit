// sample: mảng + lát có biên được kiểm (M10, tiêu chí (a)). Kết quả mong đợi: xem `// expect-result`.
// expect-result: 79
ƒ sum(xs: &[i64]) → i64 ! ∅ {
  μs ≔ 0;
  μi ≔ 0;
  ⟳ i < xs.len() ↓ xs.len() - i {
    s ← s + xs[i];
    i ← i + 1;
  }
  s
}
ƒ max(xs: &[i64]) → i64 ! ∅ {
  μm ≔ xs[0];
  μi ≔ 1;
  ⟳ i < xs.len() ↓ xs.len() - i {
    ⎇ xs[i] > m { m ← xs[i]; } ⇝ { }
    i ← i + 1;
  }
  m
}
ƒ main() → i64 ! ∅ {
  a ≔ [3i64, 9, 4, 12, 7, 1, 20];
  // sum(a)=56, sum(a[2..5])=23 ⇒ 79; max(a)=20 không vào kết quả để kiểm đọc
  sum(&a[..]) +% sum(&a[2..5]) +% (max(&a[..]) -% 20)
}
