⊔ Shape { Dot, Circle(i32), Rect(i32, i32) }
▢ P { x: i32, y: i32 }
ƒ area(s: Shape) → i32 ! ∅ {
  ⌥ s { Dot ↦ 0, Circle(r) ↦ r *% r, Rect(w, h) ↦ w *% h }
}
ƒ lits(n: i32, c: char, t: &str) → i32 ! ∅ {
  a ≔ ⌥ n { 0 ↦ 1, 1..=9 ↦ 2, _ ↦ 3 };
  b ≔ ⌥ c { 'a' ↦ 1, _ ↦ 2 };
  d ≔ ⌥ t { "x" ↦ 1, _ ↦ 2 };
  a +% b +% d
}
ƒ nested(o: Option<(bool, P)>) → i32 ! ∅ {
  ⌥ o { Some((true, P { x, .. })) ↦ x, Some((false, p)) ↦ p.y, None ↦ 0 }
}
