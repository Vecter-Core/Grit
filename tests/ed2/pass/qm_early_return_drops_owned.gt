// expect: pass
// note: ADR-P2-09 — thoát sớm bằng `?` đi qua cùng đường thoát/drop của `⏎` (không rò khối Owned, không double-drop: kiểm động ở user_drop/qm_oracle)
ƒ pick(a: &Cap<Alloc>, ok: bool) → Result<u32, u8> ! {mem} {
  o ≔ Owned::new(a, 7u32);
  r ≔ (⎇ ok { Ok(*o.get()) } ⇝ { Err(1u8) })?;
  Ok(r + 1u32)
}
