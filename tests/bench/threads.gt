// bench: 4 luồng thật × 500 000 lần (khoá thật + atomic thật) = 2 triệu cập nhật khoá và 2 triệu fetch_add. Kết quả 4 000 000.
#level("1")
▢ Lo { }
■ COUNT: Atomic<u64> ≔ Atomic::new(0u64);
■ SUM: Mutex<u64, Lo> ≔ Mutex::new(0u64);
ƒ add_one(v: &!u64, n: u64) → u64 ! ∅ { *v ← *v +% n; *v }
ƒ read(v: &!u64, n: u64) → u64 ! ∅ { *v }
ƒ worker(n: u32) ! {lock(Lo)} {
  μi ≔ 0u32;
  ⟳ i < 500000 ↓ 500000 - i {
    SUM.with(add_one, 1u64);
    COUNT.fetch_add(1u64, AtomicOrdering::Release);
    i ← i + 1;
  }
}
ƒ main() → u64 ! {lock(Lo)} {
  spawn(worker, 0u32);
  spawn(worker, 1u32);
  spawn(worker, 2u32);
  spawn(worker, 3u32);
  μspin ≔ 0u64;
  ⟳ spin < 4000000000u64 ∧ COUNT.load(AtomicOrdering::Acquire) < 2000000 ↓ 4000000000 - spin {
    spin ← spin + 1;
  }
  COUNT.load(AtomicOrdering::SeqCst) +% SUM.with(read, 0u64)
}
