// wc: đếm dòng, từ, byte của một tệp (dogfood M11→M12, docs/DOGFOOD.md). Dùng: wc.exe <đường-dẫn>
// Capability chỉ lấy ở `main` (E0310) rồi TRUYỀN XUỐNG hàm cần dùng.

// đếm trên lát byte: trả (dòng, từ)
ƒ count(b: &[u8]) → (u64, u64) ! ∅ {
  μlines ≔ 0u64;
  μwords ≔ 0u64;
  μin_word ≔ false;
  μi ≔ 0usize;
  ⟳ i < b.len() ↓ b.len() - i {
    c ≔ b[i];
    ⎇ c == 10u8 { lines ← lines + 1; } ⇝ { }
    sp ≔ c == 32u8 ∨ c == 10u8 ∨ c == 9u8 ∨ c == 13u8;
    ⎇ sp { in_word ← false; } ⇝ { ⎇ in_word { } ⇝ { words ← words + 1; in_word ← true; } }
    i ← i + 1;
  }
  (lines, words)
}

ƒ report(out: &Cap<Out>, lines: u64, words: u64, bytes: u64, path: &str) ! {io} {
  out.write_u64(lines);
  out.write_str(" ");
  out.write_u64(words);
  out.write_str(" ");
  out.write_u64(bytes);
  out.write_str(" ");
  out.write_str(path);
  out.write_str("\n");
}

ƒ main() ! {io} {
  env ≔ root_env();
  fs ≔ root_fs();
  out ≔ root_out();
  path ≔ env.arg(1usize);
  f ≔ fs.read(path);
  b ≔ f.bytes();
  r ≔ count(b);
  report(&out, r.0, r.1, b.len() as u64, path);
}
