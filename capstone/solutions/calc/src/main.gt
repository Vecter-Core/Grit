// calc: máy tính i64 đọc stdin, mỗi dòng một biểu thức.
// err: 0 ok, 1 unexpected end of input, 2 unexpected character, 3 expected ')',
//      4 trailing input, 5 integer too large, 6 overflow, 7 division by zero, 8 budget
▢ St { pos: usize, err: u32, col: usize }

ƒ fail(st: &!St, code: u32, col: usize) ! ∅ {
  st.err ← code;
  st.col ← col;
}

ƒ fail_here(st: &!St, code: u32) ! ∅ {
  st.err ← code;
  st.col ← st.pos + 1usize;
}

// bỏ khoảng trắng, trả mã byte hiện tại hoặc 256 nếu hết dòng
ƒ peek(b: &[u8], st: &!St) → u32 ! ∅ {
  n ≔ b.len();
  μp ≔ st.pos;
  ⟳ p < n ↓ n - p {
    c ≔ b[p];
    ⎇ c == 32u8 ∨ c == 9u8 { p ← p + 1usize; } ⇝ { ⊠; }
  }
  st.pos ← p;
  ⎇ p < n { b[p] as u32 } ⇝ { 256u32 }
}

ƒ acc_digit(v: u64, d: u64) → Option<u64> ! ∅ {
  ⌥ v *? 10u64 {
    Some(x) ↦ x +? d,
    None ↦ None,
  }
}

ƒ primary(b: &[u8], st: &!St, budget: u32) → i64 ! ∅ ↓ budget {
  ⎇ budget == 0u32 {
    fail_here(st, 8u32);
    0i64
  } ⇝ {
    c ≔ peek(b, st);
    n ≔ b.len();
    ⎇ c == 256u32 {
      fail(st, 1u32, n + 1usize);
      0i64
    } ⇝ ⎇ c >= 48u32 ∧ c <= 57u32 {
      start ≔ st.pos;
      μp ≔ start;
      μv ≔ 0u64;
      μbad ≔ false;
      ⟳ p < n ↓ n - p {
        d ≔ b[p];
        ⎇ d >= 48u8 ∧ d <= 57u8 {
          ⎇ bad { } ⇝ {
            ⌥ acc_digit(v, (d - 48u8) as u64) {
              Some(x) ↦ { v ← x; },
              None ↦ { bad ← true; },
            }
          }
          p ← p + 1usize;
        } ⇝ { ⊠; }
      }
      st.pos ← p;
      ⎇ bad ∨ v > 9223372036854775807u64 {
        fail(st, 5u32, start + 1usize);
        0i64
      } ⇝ {
        v as i64
      }
    } ⇝ ⎇ c == 40u32 {
      st.pos ← st.pos + 1usize;
      v ≔ expr(b, st, budget - 1u32);
      ⎇ st.err != 0u32 {
        0i64
      } ⇝ {
        c2 ≔ peek(b, st);
        ⎇ c2 == 41u32 {
          st.pos ← st.pos + 1usize;
          v
        } ⇝ ⎇ c2 == 256u32 {
          fail(st, 1u32, n + 1usize);
          0i64
        } ⇝ {
          fail_here(st, 3u32);
          0i64
        }
      }
    } ⇝ {
      fail_here(st, 2u32);
      0i64
    }
  }
}

ƒ unary(b: &[u8], st: &!St, budget: u32) → i64 ! ∅ ↓ budget {
  ⎇ budget == 0u32 {
    fail_here(st, 8u32);
    0i64
  } ⇝ {
    c ≔ peek(b, st);
    ⎇ c == 45u32 {
      col ≔ st.pos + 1usize;
      st.pos ← st.pos + 1usize;
      v ≔ unary(b, st, budget - 1u32);
      ⎇ st.err != 0u32 {
        0i64
      } ⇝ {
        ⌥ 0i64 -? v {
          Some(r) ↦ r,
          None ↦ {
            fail(st, 6u32, col);
            0i64
          },
        }
      }
    } ⇝ {
      primary(b, st, budget - 1u32)
    }
  }
}

ƒ term(b: &[u8], st: &!St, budget: u32) → i64 ! ∅ ↓ budget {
  ⎇ budget == 0u32 {
    fail_here(st, 8u32);
    0i64
  } ⇝ {
    μa ≔ unary(b, st, budget - 1u32);
    μfuel ≔ b.len() as u64 + 2u64;
    ⟳ fuel > 0u64 ↓ fuel {
      ⎇ st.err != 0u32 { ⊠; } ⇝ { }
      c ≔ peek(b, st);
      ⎇ c == 42u32 ∨ c == 47u32 {
        col ≔ st.pos + 1usize;
        st.pos ← st.pos + 1usize;
        r ≔ unary(b, st, budget - 1u32);
        ⎇ st.err != 0u32 {
          ⊠;
        } ⇝ ⎇ c == 42u32 {
          ⌥ a *? r {
            Some(x) ↦ { a ← x; },
            None ↦ { fail(st, 6u32, col); },
          }
        } ⇝ ⎇ r == 0i64 {
          fail(st, 7u32, col);
        } ⇝ ⎇ a == -9223372036854775807i64 - 1i64 ∧ r == -1i64 {
          fail(st, 6u32, col);
        } ⇝ {
          a ← a / r;
        }
      } ⇝ { ⊠; }
      fuel ← fuel - 1u64;
    }
    core::fuel_left(fuel);
    ⎇ st.err != 0u32 { 0i64 } ⇝ { a }
  }
}

ƒ expr(b: &[u8], st: &!St, budget: u32) → i64 ! ∅ ↓ budget {
  ⎇ budget == 0u32 {
    fail_here(st, 8u32);
    0i64
  } ⇝ {
    μa ≔ term(b, st, budget - 1u32);
    μfuel ≔ b.len() as u64 + 2u64;
    ⟳ fuel > 0u64 ↓ fuel {
      ⎇ st.err != 0u32 { ⊠; } ⇝ { }
      c ≔ peek(b, st);
      ⎇ c == 43u32 ∨ c == 45u32 {
        col ≔ st.pos + 1usize;
        st.pos ← st.pos + 1usize;
        r ≔ term(b, st, budget - 1u32);
        ⎇ st.err != 0u32 {
          ⊠;
        } ⇝ ⎇ c == 43u32 {
          ⌥ a +? r {
            Some(x) ↦ { a ← x; },
            None ↦ { fail(st, 6u32, col); },
          }
        } ⇝ {
          ⌥ a -? r {
            Some(x) ↦ { a ← x; },
            None ↦ { fail(st, 6u32, col); },
          }
        }
      } ⇝ { ⊠; }
      fuel ← fuel - 1u64;
    }
    core::fuel_left(fuel);
    ⎇ st.err != 0u32 { 0i64 } ⇝ { a }
  }
}

ƒ is_blank(b: &[u8]) → bool ! ∅ {
  n ≔ b.len();
  μp ≔ 0usize;
  μres ≔ true;
  ⟳ p < n ↓ n - p {
    c ≔ b[p];
    ⎇ c == 32u8 ∨ c == 9u8 { p ← p + 1usize; } ⇝ { res ← false; ⊠; }
  }
  res
}

ƒ msg(code: u32) → &str ! ∅ {
  ⎇ code == 1u32 { "unexpected end of input" }
  ⇝ ⎇ code == 2u32 { "unexpected character" }
  ⇝ ⎇ code == 3u32 { "expected ')'" }
  ⇝ ⎇ code == 4u32 { "trailing input" }
  ⇝ ⎇ code == 5u32 { "integer too large" }
  ⇝ ⎇ code == 6u32 { "overflow" }
  ⇝ ⎇ code == 7u32 { "division by zero" }
  ⇝ { "nesting too deep" }
}

ƒ main() ! {io, div, mem} {
  inp ≔ root_in();
  out ≔ root_out();
  data ≔ ⌥ inp.read_all() { Ok(f) ↦ f.bytes(), Err(_) ↦ "".as_bytes() };
  n ≔ data.len();
  μpos ≔ 0usize;
  μany ≔ false;
  μst ≔ St { pos: 0usize, err: 0u32, col: 0usize };
  ⟳ pos < n ↓ n - pos {
    end ≔ data.find_byte_or_end(pos, 10u8);
    line ≔ &data[pos..end];
    ⎇ is_blank(line) { } ⇝ {
      st.pos ← 0usize;
      st.err ← 0u32;
      st.col ← 0usize;
      v ≔ expr(line, &!st, 5000000u32);
      ⎇ st.err == 0u32 {
        c ≔ peek(line, &!st);
        ⎇ c != 256u32 { fail_here(&!st, 4u32); } ⇝ { }
      } ⇝ { }
      ⎇ st.err == 0u32 {
        out.write_i64(v);
        out.write_str("\n");
      } ⇝ {
        any ← true;
        out.write_str("error: ");
        out.write_str(msg(st.err));
        out.write_str(" at ");
        out.write_u64(st.col as u64);
        out.write_str("\n");
      }
    }
    pos ← end + 1usize;
  }
  ⎇ any { core::exit(1u32) } ⇝ { }
}
