+/// BẢN THỬ PORT LINUX (bộ kiểm toán, KHÔNG có trong dự án gốc): khoá quay + nhường luồng trên ô 8 byte khởi tạo 0.
+///
+/// # Safety
+/// `lock` trỏ tới ô 8 byte căn lề 8, khởi tạo 0.
+#[cfg(not(windows))]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn gritrt_mutex_lock(lock: *mut u8) {
+    let a = unsafe { &*lock.cast::<std::sync::atomic::AtomicU64>() };
+    while a
+        .compare_exchange_weak(0, 1, std::sync::atomic::Ordering::Acquire, std::sync::atomic::Ordering::Relaxed)
+        .is_err()
+    {
+        std::thread::yield_now();
+    }
+}
+
+/// # Safety
+/// Như `gritrt_mutex_lock`.
+#[cfg(not(windows))]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn gritrt_mutex_unlock(lock: *mut u8) {
+    let a = unsafe { &*lock.cast::<std::sync::atomic::AtomicU64>() };
+    a.store(0, std::sync::atomic::Ordering::Release);
+}
