+/// `gt_codegen_llvm` không được liên kết nên cần một kiểu `Opt` thay thế để `--no-default-features` biên dịch được.
+#[cfg(not(feature = "llvm"))]
+mod gt_codegen_llvm {
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub enum Opt {
+        Dev,
+        Release,
+        ReleaseO2,
+    }
+    impl Opt {
+        pub fn is_release(self) -> bool {
+            !matches!(self, Opt::Dev)
+        }
+    }
